# =============================================================================
# RF Spectrum Explorer — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth / Auth.js
# AUTH_SECRET and NEXTAUTH_SECRET are equivalent; NextAuth v4 reads either.
# Generate a strong random value:
#   openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=<generate with: openssl rand -base64 32>
NEXTAUTH_SECRET=${AUTH_SECRET}   # can be the same value or set independently

# Public URL of this application — used by NextAuth to build callback URLs.
# AUTH_URL and NEXTAUTH_URL are equivalent; set both to be safe.
AUTH_URL=https://rfexplorer.evrslab.com
NEXTAUTH_URL=https://rfexplorer.evrslab.com

# -----------------------------------------------------------------------------
# Authentik OIDC provider
# Create an OAuth2/OIDC provider in Authentik and copy the values here.
# Callback URL to register in Authentik:
#   https://rfexplorer.evrslab.com/api/auth/callback/authentik
# -----------------------------------------------------------------------------
AUTH_AUTHENTIK_ID=<client id from Authentik>
AUTH_AUTHENTIK_SECRET=<client secret from Authentik>

# Issuer must match the Authentik application slug, no trailing slash.
# NextAuth uses this to discover OIDC endpoints via:
#   ${AUTH_AUTHENTIK_ISSUER}/.well-known/openid-configuration
AUTH_AUTHENTIK_ISSUER=https://auth.evrslab.com/application/o/rfexplorer

# -----------------------------------------------------------------------------
# Backend API (set to the internal address reachable from the Next.js container)
# NEXT_PUBLIC_ prefix exposes this to the browser bundle.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://backend:8000

# MinIO / object storage (backend reads these, not the frontend)
MINIO_ENDPOINT=10.10.100.28:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rf-lake
MINIO_USE_SSL=false
